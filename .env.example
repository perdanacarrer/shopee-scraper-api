PORT=3000
NODE_ENV=development

# In-memory cache TTL (seconds) - avoids re-hitting Shopee for the same item repeatedly
CACHE_TTL=600

# Request behavior
SCRAPER_TIMEOUT=30000
SCRAPER_RETRIES=3
SCRAPER_RETRY_DELAY=1000
SCRAPER_RATE_LIMIT=10
LOG_LEVEL=info

# Optional: comma-separated list of User-Agent strings to rotate through.
# Leave unset to use the built-in defaults.
# USER_AGENTS=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...,Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) ...

# Optional proxy (only if you already own/rent your own proxy - not required to run this)
PROXY_ENABLED=false
# PROXY_URL=http://your-own-proxy-host:port
# PROXY_LIST=proxy1-host:port,proxy2-host:port
PROXY_ROTATION_STRATEGY=round-robin
